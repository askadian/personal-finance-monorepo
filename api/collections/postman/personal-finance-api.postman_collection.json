  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script for the entire collection",
          "// This can be used to set dynamic variables or perform authentication",
          "",
          "// Example: Set current date if not already set",
          "if (!pm.collectionVariables.get('start_date')) {",
          "    const today = new Date();",
          "    const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);",
          "    pm.collectionVariables.set('start_date', firstDay.toISOString().split('T')[0]);",
          "}",
          "",
          "if (!pm.collectionVariables.get('end_date')) {",
          "    const today = new Date();",
          "    pm.collectionVariables.set('end_date', today.toISOString().split('T')[0]);",
          "}"
        ]
      }
