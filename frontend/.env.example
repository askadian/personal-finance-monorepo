# AWS Cognito Configuration (Example)
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and will not be committed

# IMPORTANT: Do not commit actual credentials to version control

# AWS Configuration
REACT_APP_AWS_REGION=us-east-1
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_abcd1234
REACT_APP_COGNITO_APP_CLIENT_ID=1a2b3c4d5e6f7g8h9i0j1k2l3m

# OPTIONAL: Only needed if your App Client is configured with a secret
# WARNING: Frontend apps should NOT have client secrets (they should be public clients)
# If you're getting "SECRET_HASH was not received" error, you need to either:
# 1. Reconfigure your App Client as a public client (RECOMMENDED), or
# 2. Add the client secret here (NOT RECOMMENDED for production)
# REACT_APP_COGNITO_APP_CLIENT_SECRET=your_client_secret_here

# Optional: Cognito Domain for Hosted UI
REACT_APP_COGNITO_DOMAIN=your-app-name.auth.us-east-1.amazoncognito.com

# Optional: OAuth Configuration
REACT_APP_OAUTH_REDIRECT_SIGN_IN=http://localhost:3000/
REACT_APP_OAUTH_REDIRECT_SIGN_OUT=http://localhost:3000/

# Cookie Configuration
REACT_APP_COOKIE_DOMAIN=localhost
REACT_APP_COOKIE_SECURE=false

# S3 File Upload Configuration
# The S3 bucket name for file uploads (follows naming convention: {base-name}-{environment})
# Example: personal-finance-uploads-dev, personal-finance-uploads-prod
REACT_APP_S3_BUCKET_NAME=personal-finance-uploads-dev

# API Gateway Endpoint
# The base URL for your API Gateway endpoint
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod
# This is used for getting presigned URLs for file uploads
REACT_APP_API_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
